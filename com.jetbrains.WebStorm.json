{
    "id": "com.jetbrains.WebStorm",
    "runtime": "org.freedesktop.Sdk",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "webstorm-wrapper",
    "finish-args": [
        "--device=dri",
        "--env=FLATPAK_ENABLE_SDK_EXT=node24",
        "--filesystem=home",
        "--share=ipc",
        "--share=network",
        "--socket=ssh-auth",
        "--socket=gpg-agent",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.freedesktop.FileManager1"
    ],
    "modules": [
        {
            "name": "webstorm",
            "build-commands": [
                "cp -a WebStorm-*/* ${FLATPAK_DEST}",
                "cat idea.properties >> ${FLATPAK_DEST}/bin/idea.properties",
                "install -Dm644 -t ${FLATPAK_DEST}/share/applications/ ${FLATPAK_ID}.desktop",
                "install -Dm644 -t ${FLATPAK_DEST}/share/metainfo/ ${FLATPAK_ID}.metainfo.xml",
                "install -Dm644 -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/ ${FLATPAK_ID}.svg"
            ],
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "strip-components": 0,
                    "only-arches": [
                        "x86_64"
                    ],
                    "sha256": "62b78a642d8962b43bf420558fa1fcbbee039d03d690d7e73f02c1450c8b5982",
                    "url": "https://download.jetbrains.com/webstorm/WebStorm-2026.3.tar.gz",
                    "x-checker-data": {
                        "code": "WS",
                        "is-main-source": true,
                        "type": "jetbrains"
                    }
                },
                {
                    "type": "archive",
                    "strip-components": 0,
                    "only-arches": [
                        "aarch64"
                    ],
                    "sha256": "5e25f3bee51ef9f2a858f5b94fb3cccec766c55a9ad5ba1555dab0e0cc52cfc1",
                    "url": "https://download.jetbrains.com/webstorm/WebStorm-2026.3-aarch64.tar.gz",
                    "x-checker-data": {
                        "code": "WS",
                        "is-main-source": true,
                        "type": "jetbrains"
                    }
                },
                {
                    "type": "file",
                    "path": "com.jetbrains.WebStorm.desktop"
                },
                {
                    "type": "file",
                    "path": "com.jetbrains.WebStorm.svg"
                },
                {
                    "type": "file",
                    "path": "com.jetbrains.WebStorm.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "idea.properties"
                }
            ]
        },
        {
            "name": "dbus",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtools=true",
                "-Dmessage_bus=false",
                "-Dsystemd=disabled",
                "-Dx11_autolaunch=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.4.tar.xz",
                    "sha256": "d08b05526c2cb7966a5fb79210d6112b1aca3d135f315c1b302e14b4b0297dac",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5356,
                        "stable-only": true,
                        "url-template": "https://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "ide-flatpak-wrapper",
            "buildsystem": "meson",
            "config-opts": [
                "-Deditor_binary=/app/bin/webstorm",
                "-Deditor_title=WebStorm",
                "-Dprogram_name=webstorm-wrapper",
                "-Dfirst_run_template=README.md",
                "-Dflagfile_prefix=flatpak-webstorm"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flathub/ide-flatpak-wrapper.git",
                    "commit": "a9d22d1b36fc8bb814c77d70957715bbc5840f83"
                },
                {
                    "type": "file",
                    "path": "README.md"
                }
            ]
        }
    ]
}
